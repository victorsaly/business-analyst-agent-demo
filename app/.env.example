# Your AI key for Live AI. Setup copies this file to .env; put the key there, never in this file.
# Free Groq key: https://console.groq.com/keys (starts with gsk_). Paste it straight after the =, no spaces.
# No key? Replay mode works without one. Never share or commit .env.
GROQ_API_KEY=
# Optional overrides:
# LLM_MODEL=openai/gpt-oss-120b            # separate daily allowance on Groq
# OpenAI instead of Groq:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=<an OpenAI model name>
# Fully local with Ollama (no key needed):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b
