# Copy to .env (./demo.sh setup does this) and fill in. Never commit .env.
GROQ_API_KEY=
# Optional overrides:
# LLM_MODEL=openai/gpt-oss-120b            # separate daily allowance on Groq
# OpenAI instead of Groq:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=<an OpenAI model name>
# Fully local with Ollama (no key needed):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b
